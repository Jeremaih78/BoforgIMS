# Copy to .env only if that file does not already exist. Never commit .env.
# These defaults are for LOCAL development, not production.
DJANGO_DEBUG=true
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Supply the credentials for an existing local PostgreSQL database.
POSTGRES_DB=boforg_ims
POSTGRES_USER=boforg
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# If set by your environment, DATABASE_URL overrides ALL POSTGRES_* values.
# Production: DJANGO_DEBUG=false, persistent production secret, server DB
# credentials, and PRIVATE_MEDIA_ROOT outside public web-server directories.
