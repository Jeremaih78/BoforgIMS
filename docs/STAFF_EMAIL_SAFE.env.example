# Defaults only. Company policy, recipient preferences and activation watermark
# are separate approvals. Do not paste real keys into source or command arguments.
TASKER_CLOUD_EMAIL_ENABLED=false
TASKER_REPORT_EMAIL_LIVE_ENABLED=false
TASKER_EMAIL_ORIGIN=https://ai.example.invalid
TASKER_EMAIL_URLCONF=config.host_urls.ai
# Private JSON company-id -> {url, token_file}; token stays in a private file.
TASKER_CLOUD_EMAIL_CLIENTS={}
# Private JSON company-id -> {key-id: independent eligibility HMAC secret}.
TASKER_CLOUD_EMAIL_KEYS={}
# Separate receipt HMAC secret, matching Cloud's callback secret for this app.
TASKER_CLOUD_EMAIL_RECEIPT_KEYS={}
